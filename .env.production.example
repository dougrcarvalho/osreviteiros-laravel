# Copie para .env na VPS (nunca versionar o .env). Gere APP_KEY com:
#   docker compose -f compose.prod.yaml run --rm --no-deps -e RUN_MIGRATIONS=false app php artisan key:generate --show
APP_NAME="Os Reviteiros"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://osreviteiros.zivit.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=reviteiros
DB_USERNAME=reviteiros
DB_PASSWORD=TROCAR
DB_ROOT_PASSWORD=TROCAR

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

CHECKOUT_GRATIS_URL=
CHECKOUT_BASIC_URL=
CHECKOUT_PREMIUM_URL=

REVITEIROS_ARQUIVOS_DISK=local
REVITEIROS_ARQUIVOS_MAX_MB=500
REVITEIROS_IMAGENS_DISK=public

# true = migrations + seeders de planos/taxonomias a cada start
RUN_MIGRATIONS=true
